# Copy to .env (never commit .env)
DB_PASSWORD=change-this-database-password
KRIVE_ADMIN_USER=admin
KRIVE_ADMIN_PASSWORD=change-this-to-a-long-random-password
# Where your storefront is served from (comma separated)
KRIVE_CORS_ORIGINS=https://shop.example.com
# true = load the 12 sample products on the very first start
KRIVE_SEED_CATALOG=false
